# Kopieren nach .env und anpassen:  cp .env.example .env
# Die .env enthält Passwörter – nicht weitergeben und nicht ins Git einchecken.

# --- Server ---
# Domain ohne https:// (landet im QR-Code jedes Nachweises, später nicht mehr ändern)
DOMAIN=uvv.example.org
# Ordner auf dem Server für Datenbank und Logo
DATA_PATH=./data
# Port auf dem Server (bei Betrieb hinter Traefik egal)
HTTP_PORT=8000

# --- Erster Admin (wird nur beim allerersten Start angelegt) ---
ADMIN_USER=admin
# mindestens 10 Zeichen; danach unter „Mein Konto“ ändern
ADMIN_PASSWORD=

# --- Mailversand der Nachweise (ohne SMTP_HOST wird der Mail-Knopf ausgeblendet) ---
SMTP_HOST=
SMTP_PORT=587
# starttls (Port 587) | ssl (Port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="UVV Unterweisungen <uvv@example.org>"
# Sperrzeit gegen mehrfaches Abschicken desselben Nachweises
MAIL_COOLDOWN_MINUTES=10

# --- Vorgaben für neue Unterweisungen ---
PASS_PERCENT=80
VALID_MONTHS=12
DEFAULT_MAIL_TO=

# --- Optional: Startwerte für die „Einstellungen“ (nur beim ersten Start, danach in der Verwaltung pflegen) ---
# ORG_NAME=Freiwillige Feuerwehr Musterstadt
# BRAND_TOP=Feuerwehr
# BRAND_BOTTOM=Musterstadt
# PRIMARY_COLOR="#BA0000"
# SIGN_PLACE=Musterstadt
# IMPRESSUM_URL=https://www.example.org/impressum
# DATENSCHUTZ_URL=https://www.example.org/datenschutz

# --- Optional ---
# Fester Schlüssel für Sitzungen; ohne Angabe wird einer erzeugt und im Datenordner gespeichert
# SECRET_KEY=
# Nur für die Übernahme einer alten UVV-Drohne-Datenbank: Empfänger der Drohnen-Unterweisung
# MAIL_TO=
# Nur zum lokalen Testen ohne HTTPS (z. B. http://localhost:8000): sonst funktioniert die Anmeldung nicht
# COOKIE_SECURE=0
